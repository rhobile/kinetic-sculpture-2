
rules_version = '2';

// FIREBASE STORAGE SECURITY RULES
service firebase.storage {
  match /b/{bucket}/o {
    
    // Unified Admin check for rhobile@gmail.com
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'rhobile@gmail.com' ||
        request.auth.uid == 'ge6KSJEZKFXsNZerEbXseOR2vSS2' ||
        request.auth.uid == 'gHZ9n7s2b9X8fJ2kP3s5t8YxVOE2'
      );
    }

    match /{allPaths=**} {
      // Publicly readable for the gallery and management preview
      allow read: if true;
      // Protected write access for authorized admins
      allow write: if isAdmin();
    }
  }
}
